{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "backend/**/*.ts",
    "experimentos/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "experimentos/resultados-crudos"
  ]
}
