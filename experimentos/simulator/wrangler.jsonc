{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "solventa-exp-simulator",
  "main": "index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "BANK_TOKEN"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EVIDENCE",
        "class_name": "Evidence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Evidence"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "workers_dev": false
}
